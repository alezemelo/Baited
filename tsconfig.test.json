{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "tests/**/*.ts",
    "src/features/workflow/catalog.ts",
    "src/features/workflow/api/**/*.ts",
    "src/features/workflow/types.ts",
    "src/features/workflow/validation/**/*.ts"
  ]
}

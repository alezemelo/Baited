{
  "name": "baited",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"npm:mock:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "mock:api": "node mocks/server.cjs",
    "mock:api:reset": "node mocks/server.cjs --reset",
    "mock:api:e2e": "node mocks/server.cjs --host 127.0.0.1 --port 3002 --db mocks/data/e2e-db.json --reset",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:domain && npm run test:unit",
    "test:domain": "tsc -p tsconfig.test.json && cp tests/package.test.json .tmp-tests/package.json && node --test .tmp-tests/tests/*.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@xyflow/react": "^12.11.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "10.0.3",
    "jsdom": "^29.1.1",
    "json-server": "0.17.4",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
